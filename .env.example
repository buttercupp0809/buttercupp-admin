# poppy-admin environment template.
# Copy to .env.local and fill in real values before running locally or deploying.
# Never commit .env.local or any file containing real secrets.

# ---------------------------------------------------------------------------
# Database (must point at the same Postgres instance as the poppy app)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres@localhost:5432/poppy_dev?sslmode=disable

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# Comma-separated list of admin email addresses.
ADMIN_EMAILS=you@example.com

# Hashed password for each admin. Generate with:
#   node -e "const b=require('bcryptjs');b.hash('your-password',10).then(console.log)"
# Name must be the email prefix (before @) uppercased.
ADMIN_PASSWORD_HASH_YOU=

# JWT secret for the admin session cookie.
ADMIN_JWT_SECRET=

# ---------------------------------------------------------------------------
# Email (Resend - transactional/low-volume, stays as-is)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Email nurture pipeline (Brevo - bulk lifecycle emails, 300/day free)
# ---------------------------------------------------------------------------
# Brevo API key. Get from https://app.brevo.com/settings/keys/api
# Format: xkeysib-<hex>
BREVO_API_KEY=

# Sender display name + address used for all nurture emails.
# Must be a verified sender in both Resend (transactional) and Brevo (nurture).
EMAIL_FROM=Buttercupp <admin@buttercupp.fun>

# Secret used to sign one-click unsubscribe tokens (HMAC-SHA256).
# Falls back to CRON_SECRET then ADMIN_JWT_SECRET if not set.
# Rotate this only if you need to invalidate all existing unsubscribe tokens.
UNSUBSCRIBE_SECRET=

# ---------------------------------------------------------------------------
# Cron endpoint guard
# ---------------------------------------------------------------------------
# Used to authenticate calls to /api/cron/nurture (and any future cron routes).
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
# Canonical URL of the main poppy app (used in email CTAs and unsubscribe links).
NEXT_PUBLIC_APP_URL=https://www.buttercupp.fun

# Admin app URL (used to build unsubscribe links in nurture emails).
# Defaults to NEXT_PUBLIC_APP_URL if not set.
NEXT_PUBLIC_ADMIN_URL=https://admin.buttercupp.fun

# ---------------------------------------------------------------------------
# AWS / Media
# ---------------------------------------------------------------------------
AWS_REGION=eu-north-1
S3_BUCKET=poppy-character-media
POPPY_S3_REGION=eu-north-1
POPPY_S3_BUCKET_GENERATED=poppy-generated
# Optional: CloudFront CDN prefix for character images in emails.
# If set, images are served via CDN (no per-request S3 presigning).
CLOUDFRONT_URL=
