// Poppy (ButterCupp) database schema — mirrored for admin use.
// Source of truth: poppy/packages/database/prisma/schema.prisma
// Admin does NOT run migrations. DDL is owned by the Poppy repo.
// vector(384) embedding columns are commented out — admin never queries them.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum SubscriptionTier {
  free
  premium
  pro
}

enum ContentRating {
  sfw
  mature
}

enum Visibility {
  private
  public
}

enum CharacterStyle {
  realistic
  threeD
  anime
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum MemoryTier {
  hot
  warm
  cold
}

enum MediaKind {
  image
  voice
  video
}

enum MediaStatus {
  queued
  processing
  ready
  failed
}

enum TokenReason {
  purchase
  image_gen
  voice_gen
  premium_msg
  grant
}

enum MessageRole {
  user
  assistant
  system
}

enum AgeVerificationLevel {
  none
  self_declared
  vendor_verified
}

// =============================================================================
// Users, auth, age & compliance
// =============================================================================

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String?
  oauthProvider          String?
  googleId               String?              @unique
  dob                    DateTime?
  jurisdiction           String?
  subscriptionTier       SubscriptionTier     @default(free)
  tokenBalance           Int                  @default(0)
  freeMessagesUsed       Int                  @default(0)
  ageVerifiedAt          DateTime?
  ageVerificationLevel   AgeVerificationLevel @default(none)
  emailVerifiedAt        DateTime?
  tosAcceptedAt          DateTime?
  privacyAcceptedAt      DateTime?
  consentAcceptedAt      DateTime?
  acceptedPolicyVersion  String?
  completedOnboardingAt  DateTime?
  // Mirrors poppy schema: last-login device snapshot. Owned by poppy repo;
  // admin only reads these. Bucket values: "mobile" | "tablet" | "desktop"
  // | "unknown". UA is truncated to 512 chars at write time in the poppy
  // repo. See poppy/packages/database/prisma/schema.prisma for the full
  // rationale.
  lastLoginAt            DateTime?
  lastLoginDeviceType    String?
  lastLoginUserAgent     String?
  lastLoginCountry       String?
  // Email nurture pipeline: mirrors poppy schema unsubscribe fields.
  // Owned by poppy repo; admin reads + writes via the unsubscribe endpoint.
  unsubscribedAt         DateTime?
  unsubscribeToken       String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  characters             Character[]           @relation("CharacterOwner")
  ageVerifications       AgeVerification[]
  conversations          Conversation[]
  memories               Memory[]
  memorySummaries        MemorySummary[]
  relationshipStates     RelationshipState[]
  subscription           Subscription?
  tokenLedger            TokenLedger[]
  mediaAssets            MediaAsset[]
  crisisEvents           CrisisEvent[]
  magicLinks             MagicLink[]
  reelLikes              ReelLike[]
  profile                UserProfile?
  memoryEntities         MemoryEntity[]
  memoryEdges            MemoryEdge[]
  userRules              UserRule[]
  usageCounters          UsageCounter[]
  emailSendLogs          EmailSendLog[]
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  displayName  String?
  gender       String?
  preferences  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgeVerification {
  id           String               @id @default(uuid())
  userId       String
  provider     String
  level        AgeVerificationLevel
  status       String
  evidenceRef  String?
  verifiedAt   DateTime?
  createdAt    DateTime             @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLink {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  purpose     String    @default("login")
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// =============================================================================
// Characters + versions + assets
// =============================================================================

model Character {
  id                String            @id @default(uuid())
  ownerUserId       String?
  name              String
  age               Int
  gender            String
  bio               String
  tags              String[]
  style             CharacterStyle
  contentRating     ContentRating     @default(sfw)
  visibility        Visibility        @default(private)
  moderationStatus  ModerationStatus  @default(pending)
  currentVersionId  String?
  popularityScore   Float             @default(0)
  location          String?
  seedKey           String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner             User?             @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  versions          CharacterVersion[] @relation("CharacterVersions")
  currentVersion    CharacterVersion?  @relation("CharacterCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  media             CharacterMedia[]

  @@index([visibility, moderationStatus])
  @@index([contentRating])
  @@index([popularityScore])
  @@index([ownerUserId])
}

model CharacterVersion {
  id                       String            @id @default(uuid())
  characterId              String
  versionNo                Int
  personality              String
  backstory                String
  behavioralInstructions   String
  greeting                 String
  appearanceSheetId        String?
  voiceProfileId           String?
  systemPromptSnapshot     String
  createdAt                DateTime          @default(now())

  character                Character         @relation("CharacterVersions", fields: [characterId], references: [id], onDelete: Cascade)
  appearanceSheet          AppearanceSheet?  @relation(fields: [appearanceSheetId], references: [id], onDelete: SetNull)
  voiceProfile             VoiceProfile?     @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  currentOf                Character[]       @relation("CharacterCurrentVersion")
  conversations            Conversation[]

  @@unique([characterId, versionNo])
  @@index([characterId])
}

model AppearanceSheet {
  id                  String   @id @default(uuid())
  traits              Json
  stylePrompt         String
  negativePrompt      String
  referenceImageKeys  String[]
  loraRef             String?
  createdAt           DateTime @default(now())

  versions            CharacterVersion[]
}

model VoiceProfile {
  id          String   @id @default(uuid())
  provider    String
  voiceId     String
  params      Json
  previewKey  String?
  createdAt   DateTime @default(now())

  versions    CharacterVersion[]
}

// =============================================================================
// Conversations, messages, memory
// =============================================================================

model Conversation {
  id                   String            @id @default(uuid())
  userId               String
  characterId          String
  characterVersionId   String
  lastMessageAt        DateTime?
  messageCount         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character            Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterVersion     CharacterVersion  @relation(fields: [characterVersionId], references: [id], onDelete: Restrict)
  messages             Message[]

  @@unique([userId, characterId])
  @@index([userId, lastMessageAt])
  @@index([characterId])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  role            MessageRole
  content         String
  mediaAssetId    String?
  tokenCost       Int?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model Memory {
  id                String     @id @default(uuid())
  userId            String
  characterId       String
  content           String
  category          String
  // embedding      Unsupported("vector(384)")? — admin doesn't need embeddings
  tier              MemoryTier @default(hot)
  salience          Float      @default(0.5)
  importance        Float      @default(0.5)
  confidence        Float      @default(1.0)
  emotionalValence  Float      @default(0.0)
  pinned            Boolean    @default(false)
  accessCount       Int        @default(0)
  lastAccessedAt    DateTime?
  validUntil        DateTime?
  sourceMessageId   String?
  contentHash       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
  @@index([userId, characterId, tier])
  @@index([userId, characterId, sourceMessageId])
}

model MemoryDeadLetter {
  id               String   @id @default(uuid())
  userId           String?
  characterId      String?
  sourceMessageId  String?
  stage            String
  error            String
  createdAt        DateTime @default(now())

  @@index([stage, createdAt])
  @@index([userId, characterId])
}

model MemorySummary {
  id           String   @id @default(uuid())
  userId       String
  characterId  String
  periodStart  DateTime
  periodEnd    DateTime
  summary      String
  themes       String[]
  sentiment    String?
  keyEvents    Json?
  // embedding  Unsupported("vector(384)")? — admin doesn't need embeddings
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
}

model RelationshipState {
  id              String    @id @default(uuid())
  userId          String
  characterId     String
  affectionLevel  Int       @default(0)
  milestones      String[]
  mood            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

// =============================================================================
// Billing, tokens, media
// =============================================================================

model Subscription {
  id                String            @id @default(uuid())
  userId            String            @unique
  provider          String
  tier              SubscriptionTier  @default(free)
  plan              String?
  status            String            @default("inactive")
  currentPeriodEnd  DateTime?
  externalId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

model UsageCounter {
  id          String   @id @default(uuid())
  userId      String
  counterType String
  period      String
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, counterType, period])
  @@index([userId])
}

model TokenLedger {
  id            String       @id @default(uuid())
  userId        String
  delta         Int
  reason        TokenReason
  balanceAfter  Int
  refId         String?
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MediaAsset {
  id            String       @id @default(uuid())
  userId        String
  characterId   String?
  kind          MediaKind
  s3Key         String?
  status        MediaStatus  @default(queued)
  jobId         String?
  meta          Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([jobId])
  @@index([characterId, kind])
  @@index([userId, kind])
}

// =============================================================================
// Safety, audit, analytics, flags
// =============================================================================

model CrisisEvent {
  id         String   @id @default(uuid())
  userId     String
  level      Int
  trigger    String
  action     String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actorId    String?
  action     String
  resource   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  props      Json?
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@index([createdAt])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  rollout   Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReelLike {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([reelId])
}

enum CharacterMediaKind {
  image
  video
}

model CharacterMedia {
  id          String             @id @default(uuid())
  characterId String
  kind        CharacterMediaKind
  url         String
  isPrimary   Boolean            @default(false)
  isDisplay   Boolean            @default(false)
  isMain      Boolean            @default(false)
  hidden      Boolean            @default(false)
  title       String?
  likesBase   Int                @default(0)
  sort        Int                @default(0)
  createdAt   DateTime           @default(now())
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, kind])
  @@index([kind])
  @@index([characterId, isDisplay])
  @@index([characterId, isMain])
  @@index([characterId, hidden])
}

// =============================================================================
// Phase 30: memory graph + user rulebook
// =============================================================================

model MemoryEntity {
  id             String   @id @default(uuid())
  userId         String
  characterId    String
  kind           String   @default("person")
  name           String
  normalizedName String
  relation       String?
  sentiment      Float?
  aliases        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges MemoryEdge[]

  @@unique([userId, characterId, kind, normalizedName])
  @@index([userId, characterId, kind])
}

model MemoryEdge {
  id          String   @id @default(uuid())
  userId      String
  characterId String
  sourceId    String
  targetId    String?
  entityId    String?
  relation    String
  weight      Float    @default(0.5)
  label       String?
  createdBy   String   @default("extraction")
  createdAt   DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity MemoryEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relation])
  @@index([userId, characterId, sourceId])
  @@index([userId, characterId, targetId])
  @@index([entityId])
}

model UserRule {
  id              String   @id @default(uuid())
  userId          String
  characterId     String
  ruleText        String
  instruction     String
  sourceMessageId String?
  status          String   @default("active")
  timesReinforced Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, status])
}

// =============================================================================
// Email nurture pipeline (Phase email-nurture)
// =============================================================================
//
// Mirrors poppy/packages/database/prisma/schema.prisma EmailSendLog.
// Admin reads and writes this table (orchestrator, dry-run logging, analytics).
// status values: "sent" | "dry_run" | "failed"
// segment values: 1 | 2 | 3 | 4
model EmailSendLog {
  id                String   @id @default(uuid())
  userId            String
  segment           Int
  campaign          String
  provider          String   @default("brevo")
  providerMessageId String?
  sentAt            DateTime @default(now())
  status            String   @default("sent")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, segment, sentAt])
  @@index([sentAt])
  @@index([status, sentAt])
}
